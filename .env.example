# ResumeAI Environment Variables
APP_NAME="ResumeAI - Intelligent Resume & Job Matcher"
ENVIRONMENT=development
DEBUG=True

# Gemini AI API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Database (Uses SQLite by default, or MySQL with: mysql+pymysql://root:@localhost:3306/resume_ai_db)
DATABASE_URL="sqlite:///./resume_ai.db"

# Security Secret
SECRET_KEY="resume_ai_jwt_super_secret_key_college_major_project_2026_secure"
