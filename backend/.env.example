# Environment Configuration for ResumeAI

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Security & JWT Auth
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is SQLite for zero-config out-of-the-box running:
DATABASE_URL=sqlite:///./resume_ai.db
# To connect to MySQL 8.0+:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/resume_ai_db

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx
UPLOAD_DIR=./uploads
